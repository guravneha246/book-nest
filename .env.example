# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="http://localhost:3000"

# GOOGLE OAUTH: Required for "Continue with Google" sign-in.
# Obtain these from the Google Cloud Console (APIs & Services > Credentials > OAuth 2.0 Client IDs).
# Authorized redirect URI: http://localhost:3000/api/auth/google/callback (or your production URL/api/auth/google/callback)
GOOGLE_CLIENT_ID="MY_GOOGLE_CLIENT_ID"
GOOGLE_CLIENT_SECRET="MY_GOOGLE_CLIENT_SECRET"

# VITE_API_PROXY_TARGET: Optional override for Vite development server API proxy.
# Defaults to "http://127.0.0.1:5000". Can be set to a full URL (e.g. "http://127.0.0.1:5056") or port.
# VITE_API_PROXY_TARGET="http://127.0.0.1:5000"

# DB_PATH: Optional SQLite database file path override.
# Defaults to "data/booknest.db" in development and "data/booknest.test.db" in test.
# DB_PATH="data/booknest.db"

# JWT_SECRET: Required in production. Minimum 32 characters.
# Used for signing and verifying user session JSON Web Tokens.
# Generate a secure random string (e.g., node -e "console.log(require('crypto').randomBytes(32).toString('hex'))").
JWT_SECRET="generate-a-strong-random-jwt-secret-key-at-least-32-chars"

# CORS_ALLOWED_ORIGINS: Comma-separated list of allowed frontend origins for cross-origin requests.
# Defaults to APP_URL and local dev URLs (http://localhost:3000, http://127.0.0.1:3000).
# Example: CORS_ALLOWED_ORIGINS="https://booknest.campus.edu,https://staging.booknest.campus.edu"
# CORS_ALLOWED_ORIGINS=""

# TRUST_PROXY: Set to "true" or "1" (or specific subnet/hops) when deployed behind a reverse proxy (e.g. Nginx, Cloud Run).
# Ensures client IP and rate limits correctly identify remote clients via X-Forwarded-For.
# TRUST_PROXY="false"

# ALLOW_DEMO_ACCOUNTS: Keep "false" in production for security. Set to "true" only if demo accounts are explicitly approved.
ALLOW_DEMO_ACCOUNTS="false"

# CLOUDFLARE R2 & LITESTREAM CONTINUOUS SQLITE REPLICATION (Zero Data Loss on Free Hosting):
# Obtain from Cloudflare Dashboard (R2 Overview > Manage R2 API Tokens > Create API Token).
# R2_ACCOUNT_ID="your-cloudflare-account-id"
# R2_ACCESS_KEY_ID="your-r2-s3-access-key-id"
# R2_SECRET_ACCESS_KEY="your-r2-s3-secret-access-key"
# R2_BUCKET_NAME="booknest-db"

# API RATE LIMIT CONFIGURATION:
# Window durations in milliseconds and maximum requests allowed per window.
# AUTH_RATE_LIMIT_MAX="15"
# AUTH_RATE_LIMIT_WINDOW_MS="900000"     # 15 minutes
# AI_RATE_LIMIT_MAX="20"
# AI_RATE_LIMIT_WINDOW_MS="900000"       # 15 minutes
# SCANNER_RATE_LIMIT_MAX="30"
# SCANNER_RATE_LIMIT_WINDOW_MS="60000"   # 1 minute
